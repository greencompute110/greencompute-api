# Model addresses: <name>.inference.green-compute.com -> the gateway, which
# routes by Host to that one model (API key still required). Only /v1/ is
# served here; everything else lives on api.green-compute.com.
#
# Install: /etc/nginx/sites-available/inference.green-compute.com, symlinked
# into sites-enabled, plus gc-model-proxy.conf in /etc/nginx/snippets/.
# Certificates are per name, issued by gc-model-certs.

server {
    listen 80;
    server_name ~^[a-z0-9-]+\.inference\.green-compute\.com$;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: one server block per model address, written by gc-model-certs into
# /etc/nginx/model-hosts/ once its certificate exists. Static certificate
# paths, so nginx's root process loads them on reload and the keys stay
# readable by root only. Unknown names fall to the default server.
include /etc/nginx/model-hosts/*.conf;
