# Model addresses: <name>.inference.green-compute.com -> the gateway, which
# routes by Host to that one model (API key still required). Only /v1/ is
# served here; everything else lives on api.green-compute.com.
#
# Install: /etc/nginx/sites-available/inference.green-compute.com, symlinked
# into sites-enabled. Certificates are per name, issued by gc-model-certs and
# picked at handshake from the SNI name, so new ones need no reload.

server {
    listen 80;
    server_name ~^[a-z0-9-]+\.inference\.green-compute\.com$;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ~^[a-z0-9-]+\.inference\.green-compute\.com$;

    # $ssl_server_name matched the server_name pattern above, so it is a
    # plain hostname and safe in a path.
    ssl_certificate     /etc/letsencrypt/live/$ssl_server_name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$ssl_server_name/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location /v1/ {
        proxy_pass http://127.0.0.1:28000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Same as api.green-compute.com: long prefills, streaming, big bodies.
        proxy_connect_timeout 75s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        send_timeout          3600s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        client_max_body_size 256m;
        client_body_timeout  3600s;
    }

    location = / {
        default_type text/plain;
        return 200 "Green Compute model endpoint. Use https://$host/v1 as an OpenAI base URL with your API key.\n";
    }

    location / {
        return 404;
    }
}
